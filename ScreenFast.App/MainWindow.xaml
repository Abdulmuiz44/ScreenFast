<Window
    x:Class="ScreenFast.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#F8FAFC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#111827">
            <StackPanel Padding="24,28" Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock Foreground="White" FontSize="30" FontWeight="SemiBold" Text="ScreenFast" />
                    <TextBlock Foreground="#CBD5E1" Text="Native screen recorder" />
                </StackPanel>
                <TextBlock Foreground="#CBD5E1" Text="Status" />
                <TextBlock Foreground="White" TextWrapping="WrapWholeWords" Text="{x:Bind ViewModel.StateText, Mode=OneWay}" />
                <TextBlock Foreground="#CBD5E1" FontFamily="Consolas" FontSize="18" Text="{x:Bind ViewModel.TimerText, Mode=OneWay}" />
                <TextBlock Foreground="#FCA5A5" FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.CountdownText, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1">
            <StackPanel Padding="28" Spacing="16">
                <Border Padding="20" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Recorder" />
                        <TextBlock Foreground="#475569" TextWrapping="WrapWholeWords" Text="{x:Bind ViewModel.ShellMessageText, Mode=OneWay}" />
                        <TextBlock Foreground="#475569" TextWrapping="WrapWholeWords" Text="{x:Bind ViewModel.SmokeCheckSummaryText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="18" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="8">
                            <Button MinWidth="150" Command="{x:Bind ViewModel.SelectSourceCommand}" Content="Select Source" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Capture Source" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.SourceSummary, Mode=OneWay}" />
                            <TextBlock Foreground="#475569" TextWrapping="WrapWholeWords" Text="{x:Bind ViewModel.SourceDetails, Mode=OneWay}" />
                            <TextBlock Foreground="#475569" TextWrapping="WrapWholeWords" Text="{x:Bind ViewModel.SourceIdText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="18" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="8">
                            <Button MinWidth="170" Command="{x:Bind ViewModel.PickOutputFolderCommand}" Content="Output Folder" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Output" />
                            <TextBlock Foreground="#475569" TextWrapping="WrapWholeWords" Text="{x:Bind ViewModel.OutputFolderText, Mode=OneWay}" />
                            <TextBlock Foreground="#B45309" TextWrapping="WrapWholeWords" Text="{x:Bind ViewModel.DiskSpaceWarningText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Padding="18" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                    <StackPanel Spacing="14">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Recording Setup" />
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Quality" />
                            <ComboBox Grid.Column="1" DisplayMemberPath="Label" ItemsSource="{x:Bind ViewModel.QualityPresets, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedQualityPreset, Mode=TwoWay}" />
                            <ToggleSwitch Grid.Column="2" Header="System Audio" IsOn="{x:Bind ViewModel.IncludeSystemAudio, Mode=TwoWay}" />
                            <ToggleSwitch Grid.Column="3" Header="Microphone" IsOn="{x:Bind ViewModel.IncludeMicrophone, Mode=TwoWay}" />

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Countdown" />
                            <ComboBox Grid.Row="1" Grid.Column="1" DisplayMemberPath="Label" ItemsSource="{x:Bind ViewModel.CountdownOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCountdownOption, Mode=TwoWay}" />
                            <ToggleSwitch Grid.Row="1" Grid.Column="2" Header="Overlay" IsOn="{x:Bind ViewModel.OverlayEnabled, Mode=TwoWay}" />

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="After Stop" />
                            <ComboBox Grid.Row="2" Grid.Column="1" DisplayMemberPath="Label" ItemsSource="{x:Bind ViewModel.PostRecordingBehaviors, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedPostRecordingBehavior, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="18" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button MinWidth="120" MinHeight="42" Command="{x:Bind ViewModel.RecordCommand}" Content="Record" />
                        <Button Grid.Column="1" MinWidth="120" MinHeight="42" Command="{x:Bind ViewModel.PauseResumeCommand}" Content="{x:Bind ViewModel.PauseResumeText, Mode=OneWay}" />
                        <Button Grid.Column="2" MinWidth="120" MinHeight="42" Command="{x:Bind ViewModel.StopCommand}" Content="Stop" />

                        <StackPanel Grid.Column="3" Spacing="4">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Ready Check" />
                            <TextBlock Foreground="#475569" TextWrapping="WrapWholeWords" Text="{x:Bind ViewModel.ReadySourceText, Mode=OneWay}" />
                            <TextBlock Foreground="#475569" TextWrapping="WrapWholeWords" Text="{x:Bind ViewModel.ReadyOutputFolderText, Mode=OneWay}" />
                            <TextBlock Foreground="#475569" TextWrapping="WrapWholeWords" Text="{x:Bind ViewModel.AudioChoicesSummary, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Padding="18" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Recovery and Diagnostics" />
                        <TextBlock Foreground="#475569" TextWrapping="WrapWholeWords" Text="{x:Bind ViewModel.RecoveryNoticeText, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.ExportDiagnosticsCommand}" Content="Export Diagnostics" />
                            <Button Command="{x:Bind ViewModel.ClearRecoveryStateCommand}" Content="Clear Recovery" />
                            <Button Command="{x:Bind ViewModel.ShowOnboardingAgainCommand}" Content="Show onboarding" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
